def load_controls(key="load"):
    scope = st.radio("Products to load", ["Live only", "All, including disabled"], horizontal=True, key=key + "_scope")
    if st.button("Load catalogue from the store" if key == "load" else "Reload from the store", key=key, type="primary"):
