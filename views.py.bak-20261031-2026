def page_products():
    c = need_cache()
    attrs, prods = c["attributes"], c["products"]
    st.header("Products")
    import search_data as sd
    prop = sd.default_property()
    skus = product_filters(c, "p", list(SEARCH_COLS) if prop else None, show_status=False)
    st.caption(f"{len(skus)} products · catalogue copy from {c['loaded_at']}")

    table_codes = sorted((k for k, a in attrs.items() if a.get("type") in EDITABLE_TYPES - {"multiselect"}
                          and k not in core.LOCKED_PRODUCT), key=lambda k: attrs[k].get("label", k).lower())
    default = [k for k in ("name", "meta_title", "meta_description") if k in attrs]
    cols = st.multiselect("Columns", table_codes, default=default, format_func=lambda k: alabel(attrs, k), key="p_cols")
    search_cols, search = st.session_state.get("p_scols", []), {}
    if prop:
        if search_cols:
            label = st.selectbox("Search window", list(sd.WINDOWS), key="p_swin")
            start, end = sd.window(prop, label)
            search = sd.per_product(prop, start, end, prods)
            st.caption(f"Search figures for {start} to {end}." +
                       "".join(f" Includes {n} days with no data ({a} to {b})." for a, b, n in sd.gaps_inside(prop, start, end)))

    def shown(code, raw):
        a = attrs[code]
        if a.get("options"):
            return core.option_label(a, raw) if raw != "" else EMPTY
        return core.as_text(raw)

    opened = st.session_state.get("p_open")
    def search_value(sku, col):
        r = search.get(sku)
        if not r:
            return "" if col == "Top query" else None
        v = r[SEARCH_COLS[col]]
        if col == "CTR":
            return round(v * 100, 1)
        if col == "Avg. position":
            return round(v, 1) if v is not None else None
        return v

    df = pd.DataFrame([{"open": s == opened, "sku": s, **{k: shown(k, prods[s].get(k, "")) for k in cols},
                        **{sc: search_value(s, sc) for sc in search_cols}} for s in skus],
                      columns=["open", "sku"] + cols + search_cols)
    df[cols] = df[cols].fillna("")
    config = {"open": st.column_config.CheckboxColumn("Open", help="Tick to open this product below", width="small"),
              "sku": st.column_config.TextColumn("SKU", disabled=True)}
    for k in cols:
        a = attrs[k]
        if a.get("options"):
            config[k] = st.column_config.SelectboxColumn(a.get("label", k), options=[EMPTY] + [o["label"] for o in a["options"]])
        else:
            config[k] = st.column_config.TextColumn(a.get("label", k))
    for sc in search_cols:
        config[sc] = (st.column_config.TextColumn(sc, disabled=True) if sc == "Top query" else
                      st.column_config.NumberColumn(sc + (" %" if sc == "CTR" else ""), disabled=True))
    # a new table (fresh edits) whenever the filters or columns change, so edits can't land on the wrong rows
    table_key = "p_table_" + str(abs(hash((tuple(skus), tuple(cols), tuple(search_cols), st.session_state.get("p_swin")))))
    edited = st.data_editor(df, column_config=config, hide_index=True, key=table_key)
    ticked = [r["sku"] for _, r in edited.iterrows() if r["open"] and r["sku"] != opened]
    if ticked and ticked[0] in skus:
        if ticked[0] != opened:
            st.session_state.p_open = ticked[0]
            import product_card
            product_card.show(ticked[0])
            return
    if st.button("Add table edits to review", type="primary"):
        changes, unmatched = [], []
        for (_, before), (_, after) in zip(df.iterrows(), edited.iterrows()):
            sku = before["sku"]
            edits = {}
            for k in cols:
                if core.norm(after[k]) == core.norm(before[k]):
                    continue
                a = attrs[k]
                if a.get("options"):
                    back = {}
                    for o in a["options"]:
                        back.setdefault(o["label"], o["value"])
                    chosen = core.norm(after[k])
                    if chosen in ("", EMPTY):
                        edits[k] = ""
                    elif chosen in back:
                        edits[k] = back[chosen]
                    else:
                        unmatched.append(f"{sku} · {a.get('label', k)}: {chosen!r} isn't an option, so it was skipped")
                else:
                    edits[k] = core.norm(after[k])
            changes += core.product_diff(sku, prods[sku], edits, attrs)
        for u in unmatched:
            st.error(u)
        st.success(f"{core.queue(changes)} changes added to Review and push.") if changes else st.info("No edits found.")

    st.divider()
    if skus:
        product_detail(c, skus)


def product_detail(c, skus):
    attrs, prods = c["attributes"], c["products"]
    if st.session_state.get("p_open") not in skus:
        st.session_state.p_open = skus[0]
    sku = st.selectbox("Open a product", skus, key="p_open",
                       format_func=lambda s: f"{s} · {prods[s].get('name', '')}")
    rec = prods[sku]
    codes = [k for k in c["set_attributes"].get(rec.get("_set", ""), []) if k in attrs]
    grouped = {g: [k for k in ks if k in codes] for g, ks in GROUPS.items()}
    taken = {k for ks in grouped.values() for k in ks}
    rest = [k for k in codes if k not in taken and attrs[k].get("type") not in ("media_image", "gallery")]
    tabs = st.tabs(["General", "Meta", "Prices", "Inventory", "Images", "Categories", "Related", "All other attributes",
                    "Search"])
    for tab, (gname, gcodes) in zip([tabs[0], tabs[1], tabs[2], tabs[7]],
                                    list(grouped.items()) + [("All other attributes", rest)]):
        with tab, st.form(f"f_{gname}_{sku}"):
            values = {k: attr_widget(attrs[k], rec.get(k, ""), f"w_{sku}_{k}") for k in gcodes}
            if st.form_submit_button("Add to review"):
                ch = core.product_diff(sku, rec, {k: v for k, v in values.items() if k not in core.LOCKED_PRODUCT}, attrs)
                st.success(f"{core.queue(ch)} changes added to Review and push.") if ch else st.info("No changes.")

    with tabs[3], st.form(f"f_stock_{sku}"):
        qty = st.text_input("Quantity", rec.get("_qty", ""), key=f"q_{sku}")
        stock = st.selectbox("Stock status", ["1", "0"], index=0 if rec.get("_is_in_stock", "1") == "1" else 1,
                             format_func=lambda v: "In stock" if v == "1" else "Out of stock", key=f"s_{sku}")
        if st.form_submit_button("Add to review"):
            ch = [core.new_change("stock", sku, f, rec.get("_" + f, ""), v, rec.get("name", ""))
                  for f, v in (("qty", qty), ("is_in_stock", stock)) if core.norm(v) != core.norm(rec.get("_" + f, ""))]
            st.success(f"{core.queue(ch)} changes added to Review and push.") if ch else st.info("No changes.")

    with tabs[4]:
        images_tab(sku, rec)
    with tabs[5]:
        categories_tab(c, sku, rec)
    with tabs[6]:
        related_tab(c, sku, rec)
    with tabs[8]:
        search_tab(sku, rec)


def search_tab(sku, rec):
    import search_data as sd
    prop = sd.default_property()
    if not prop:
        st.markdown(f"Connect {google_label('search_console')} first: Google → {google_label('search_console')}.",
                    unsafe_allow_html=True)
        return
    label = st.selectbox("Window", list(sd.WINDOWS), key=f"sw_{sku}")
    start, end = sd.window(prop, label)
    url = sd.page_urls(rec.get("url_key"))
    st.caption(f"Page: {url[0] if url else '(no URL key)'} · {start} to {end}")
    for a, b, n in sd.gaps_inside(prop, start, end):
        st.markdown(f"This window includes {n} days with no {google_label('search_console')} data ({a} to {b}).",
                    unsafe_allow_html=True)
    day = sd.daily(prop, rec.get("url_key"), start, end)
    if day.empty:
        st.info("No search impressions for this page in this window.")
        return
    clicks, impr = int(day["clicks"].sum()), int(day["impressions"].sum())
    m1, m2, m3, m4 = st.columns(4)
    m1.metric("Clicks", f"{clicks:,}")
    m2.metric("Impressions", f"{impr:,}")
    m3.metric("CTR", f"{clicks / impr:.1%}" if impr else "—")
    m4.metric("Avg. position", f"{day['pos_x_impr'].sum() / impr:.1f}" if impr else "—")
    a, b = st.columns(2)
    a.caption("Impressions per day")
    a.line_chart(day.set_index("date")[["impressions"]])
    b.caption("Clicks per day")
    b.line_chart(day.set_index("date")[["clicks"]])
    q = sd.queries(prop, rec.get("url_key"), start, end)
    st.markdown(f"**Searches that showed this page** · {len(q)} queries")
    st.dataframe(q, hide_index=True, column_config={
        "query": st.column_config.TextColumn("Query"), "impressions": st.column_config.NumberColumn("Impressions"),
        "clicks": st.column_config.NumberColumn("Clicks"),
        "ctr": st.column_config.NumberColumn("CTR %", format="%.1f"),
        "position": st.column_config.NumberColumn("Avg. position", format="%.1f")})
    st.caption("Google leaves anonymised searches out of the query list, so it adds up to less than the totals above.")


def images_tab(sku, rec):
    if not mg():
        st.info("Connect to the store to see images.")
        return
    try:
        media = mg().media(sku)
    except ApiError as e:
        st.error(str(e))
        return
    with st.form(f"f_img_{sku}"):
        edits = []
        for i, m in enumerate(media):
            a, b = st.columns([1, 3])
            if m.get("url"):
                a.image(m["url"], width=110)
            label = b.text_input("Label", core.norm(m.get("label")), key=f"il_{sku}_{i}")
            types = b.multiselect("Used as", ["image", "small_image", "thumbnail"], default=[t for t in m.get("types") or []
                                  if t in ("image", "small_image", "thumbnail")], key=f"it_{sku}_{i}")
            hide = b.checkbox("Hidden on product page", core.norm(m.get("exclude")) == "1", key=f"ie_{sku}_{i}")
            remove = b.checkbox("Remove this image", key=f"ir_{sku}_{i}")
            old = {"label": core.norm(m.get("label")), "types": sorted(m.get("types") or []), "exclude": core.norm(m.get("exclude")) or "0"}
            new = {"label": label, "types": sorted(types), "exclude": "1" if hide else "0"}
            if remove:
                edits.append(core.new_change("image_remove", sku, "image", m.get("file", ""), "", rec.get("name", ""),
                                             file=m.get("file"), key=m.get("file")))
            elif new != old:
                edits.append(core.new_change("image_update", sku, "image", str(old), str(new), rec.get("name", ""),
                                             file=m.get("file"), data=new, old_data=old, key=m.get("file")))
        if not media:
            st.caption("No images.")
        if st.form_submit_button("Add image changes to review"):
            st.success(f"{core.queue(edits)} changes added to Review and push.") if edits else st.info("No changes.")
    with st.form(f"f_up_{sku}"):
        up = st.file_uploader("Add an image", type=["jpg", "jpeg", "png"], key=f"up_{sku}")
        label = st.text_input("Label", rec.get("name", ""), key=f"upl_{sku}")
        types = st.multiselect("Used as", ["image", "small_image", "thumbnail"], key=f"upt_{sku}")
        if st.form_submit_button("Add upload to review") and up:
            stored = core.save_upload(up.name, up.getvalue())
            data = {"file": {"mime": up.type, "name": up.name.rsplit(".", 1)[0]},
                    "label": label, "position": 0, "types": types, "exclude": 0}
            st.success(f"{core.queue([core.new_change('image_add', sku, 'image', '', up.name, rec.get('name', ''), data=data, upload=stored, key=up.name)])} change added to Review and push.")


def categories_tab(c, sku, rec):
    flat = core.flat_categories(c.get("tree") or {})
    names = {cid: label for cid, _, _, label in flat}
    current = [x for x in rec.get("_categories", []) if x in names]
    with st.form(f"f_cat_{sku}"):
        chosen = st.multiselect("Categories", list(names), default=current, format_func=lambda x: names[x], key=f"pc_{sku}")
