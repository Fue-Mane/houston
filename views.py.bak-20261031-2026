    c = need_cache()
    attrs, prods = c["attributes"], c["products"]
    st.header("Bulk edit")
    st.subheader("1 · Products")
    skus = product_filters(c, "b")
    st.caption(f"{len(skus)} products match")
    codes = sorted((k for k, a in attrs.items() if a.get("type") in EDITABLE_TYPES and k not in core.LOCKED_PRODUCT),
                   key=lambda k: attrs[k].get("label", k).lower())
    st.subheader("2 · Attribute")
    code = st.selectbox("Attribute", codes, format_func=lambda k: alabel(attrs, k), key="b_code",
                        index=codes.index("meta_description") if "meta_description" in codes else 0)
    a = attrs[code]
    st.subheader("3 · New values")
    mode = st.radio("How", ["Same value for all matching products", "Paste a list: SKU, value"], key="b_mode")
    new_map, errors = {}, []
    if mode.startswith("Same"):
        value = attr_widget(a, "", "b_value")
        clear = st.checkbox(f"Clear {a.get('label', code)} on all matching products instead", key="b_clear")
        if clear:
            new_map = {s: "" for s in skus}
        elif value != "":
            new_map = {s: value for s in skus}
    else:
        st.caption("One product per line: the SKU, then a tab or comma, then the value. The list ignores the filters above. "
                   "For dropdown attributes, write the option's name.")
        text = st.text_area("List", height=180, key="b_list")
        by_stripped = {s.strip(): s for s in prods}
        back = {o["label"].lower(): o["value"] for o in a.get("options") or []}
        for n, line in enumerate(text.splitlines(), 1):
            if not line.strip():
                continue
            sep = "\t" if "\t" in line else ","
            if sep not in line:
                errors.append(f"line {n}: no tab or comma")
                continue
            raw_sku, value = line.split(sep, 1)
            sku = raw_sku if raw_sku in prods else by_stripped.get(raw_sku.strip())
            if not sku:
                errors.append(f"line {n}: SKU {raw_sku.strip()!r} not found")
                continue
            value = value.strip()
            if a.get("options"):
                if value.lower() not in back:
                    errors.append(f"line {n}: {value!r} isn't an option of {a.get('label')}")
                    continue
                value = back[value.lower()]
            new_map[sku] = value
    for e in errors:
        st.error(e)
    changes = []
    for sku, value in new_map.items():
        changes += core.product_diff(sku, prods[sku], {code: value}, attrs)
    if changes:
        st.subheader("Preview")
        prev = [{"SKU": ch["target"], "Name": ch["target_label"],
                 "Now": ch.get("extra", {}).get("old_label") or ch["old"], "New": ch.get("extra", {}).get("new_label") or ch["new"],
                 "Check": " · ".join(x for x in core.check(ch, attrs) if x)} for ch in changes]
        st.dataframe(pd.DataFrame(prev), hide_index=True)
        if st.button(f"Add {len(changes)} changes to review", type="primary"):
            core.queue(changes)
            st.success(f"{len(changes)} changes added to Review and push.")
    elif new_map:
        st.info("Every product already has this value.")


