    if st.button("Update from Google" if last else "Pull 16 months", type="primary", key="ga_pull"):
        bar = st.progress(0.0, "Starting")
        res = ga.pull(prop, progress=lambda f, t: bar.progress(min(float(f), 1.0), t))
        _show_ga_result(res)
        last = ga.latest_date(prop)
    if not last:
        return
    for gap_start, gap_end, n in ga.missing_ranges(prop):
        st.warning(f"No data stored for {gap_start} to {gap_end} ({n} days).")
        if st.button(f"Try again for {gap_start} to {gap_end}", key=f"ga_gap_{gap_start}"):
            _show_ga_result(ga.pull(prop, start=gap_start, end=gap_end))
    with st.expander("Re-pull a date range"):
        st.caption("Replaces what's stored for these dates in all four tables, for example to bring January 2026 "
                   "into the new one-line format for Magento action links.")
        r1, r2 = st.columns(2)
        rp_from = r1.date_input("From", _dt.date(2026, 1, 1), key="ga_rp_from")
        rp_to = r2.date_input("To", _dt.date(2026, 1, 31), key="ga_rp_to")
        if st.button("Re-pull these dates", key="ga_rp_go"):
            bar = st.progress(0.0, "Starting")
            _show_ga_result(ga.pull(prop, start=rp_from, end=rp_to,
                                    progress=lambda f, t: bar.progress(min(float(f), 1.0), t)))
    with closing_conn() as c:
        errs = pd.read_sql_query("SELECT pulled_at, table_name, start_date, end_date, error FROM ga4_pull_errors "
                                 "WHERE property = ? ORDER BY pulled_at DESC LIMIT 20", c, params=(prop,))
    if not errs.empty:
        with st.expander(f"Errors from recent pulls ({len(errs)})"):
            st.dataframe(errs, hide_index=True)
    st.markdown(f"<h3>Check against {google_label('analytics')}</h3>", unsafe_allow_html=True)
    end = _dt.date.fromisoformat(last)
    a, b = st.columns(2)
    start = a.date_input("From", end - _dt.timedelta(days=27), key="ga_from")
    stop = b.date_input("To", end, key="ga_to")
    t = ga.totals(prop, start.isoformat(), stop.isoformat())
    if t:
        m1, m2, m3, m4 = st.columns(4)
        m1.metric("Sessions", f"{t['sessions']:,}")
        m2.metric("Engaged sessions", f"{t['engaged_sessions']:,}")
        m3.metric("Purchases", f"{t['purchases']:,}")
        m4.metric("Revenue", f"{t['revenue']:,.2f}")
        st.markdown(f"{t['days']} days. In {google_label('analytics')} open Reports → Acquisition → Traffic "
                    "acquisition with exactly these dates: sessions, purchases and revenue should match the totals "
                    "row. Users aren't shown here because daily user counts can't be added up into a total for a "
                    "period.", unsafe_allow_html=True)
        with closing_conn() as c:
            df = pd.read_sql_query("SELECT date, sessions FROM ga4_totals WHERE property = ? AND date BETWEEN ? AND ? "
                                   "ORDER BY date", c, params=(prop, start.isoformat(), stop.isoformat()))
        st.line_chart(df.set_index("date"))


