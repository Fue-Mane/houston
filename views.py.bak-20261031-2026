def need_cache():
    c = cache()
    if not c:
        st.info("The catalogue isn't loaded yet. Loading reads every product from the store once; "
                "after that Houston works from a local copy and refreshes the products you change.")
        load_controls()
        st.stop()
    return c


def alabel(attrs, code):
    a = attrs.get(code, {})
    return f"{a.get('label') or code} ({code})"


def attr_widget(a, value, key):
    """One input for one attribute. Returns the value as Magento stores it."""
    code, t = a["code"], a.get("type", "text")
    label = alabel({code: a}, code)
    value = core.norm(value) if not isinstance(value, list) else ",".join(value)
    if code in core.LOCKED_PRODUCT:
        st.text_input(label + " · locked", value, disabled=True, key=key)
        return value
    opts = a.get("options") or []
    if t in ("select", "boolean") and opts:
        values = [""] + [o["value"] for o in opts]
        names = {o["value"]: o["label"] for o in opts}
        if value not in values:
            values.append(value)
        return st.selectbox(label, values, index=values.index(value),
                            format_func=lambda v: names.get(v, "(empty)" if v == "" else v), key=key)
    if t == "multiselect" and opts:
        names = {o["value"]: o["label"] for o in opts}
        current = [x for x in value.split(",") if x in names]
        return ",".join(st.multiselect(label, list(names), default=current, format_func=lambda v: names[v], key=key))
    if t in ("media_image", "gallery"):
        st.text_input(label + " · change in Images", value, disabled=True, key=key)
        return value
    if t == "textarea":
        out = st.text_area(label, value, key=key, height=160 if code == "description" else 90)
    else:
        out = st.text_input(label, value, key=key)
    if code.startswith("meta_") or code == "name":
        st.caption(f"{len(out)} characters")
    return out


def product_filters(c, key, search_options=None, show_status=True):
    prods, attrs = c["products"], c["attributes"]
    cats = core.flat_categories(c.get("tree") or {})
    filters = st.columns(3 if show_status else 2)
    f1 = filters[0]
    q = f1.text_input("Search name or SKU", key=key + "_q").strip().lower()
    if show_status:
        status = filters[1].selectbox("Status", ["All", "Live", "Disabled"], key=key + "_st")
    else:
        status = "Live"
    cat = filters[-1].selectbox("Category", [None] + cats, key=key + "_cat",
                       format_func=lambda x: "Any" if x is None else "\u2003" * max(x[2] - 1, 0) + x[1])
    if search_options is None:
        problems = st.multiselect("Show only products with", ["No meta description", "No meta title",
                                                              "No short description", "No description"], key=key + "_pr")
    else:
        problems_col, search_col = st.columns(2)
        problems_col.markdown("**Show only products with**")
        search_col.markdown(google_label("search_console"), unsafe_allow_html=True)
        problems = problems_col.multiselect("Show only products with",
                                            ["No meta description", "No meta title",
                                             "No short description", "No description"], key=key + "_pr",
                                            label_visibility="collapsed")
        search_col.multiselect("Google Search Console", search_options, key=key + "_scols",
                               label_visibility="collapsed")
    need = {"No meta description": "meta_description", "No meta title": "meta_title",
            "No short description": "short_description", "No description": "description"}
    out = []
    for sku, r in prods.items():
        if "_error" in r:
            continue
        if q and q not in sku.lower() and q not in r.get("name", "").lower():
            continue
        if status == "Live" and r.get("status") != "1" or status == "Disabled" and r.get("status") == "1":
            continue
        if cat and cat[0] not in r.get("_categories", []):
            continue
        if any(core.has_value(r.get(need[p], "")) for p in problems):
            continue
        out.append(sku)
    return out


